[Unit]
Description=Create and verify Daniel driving-log archive

[Service]
Type=oneshot
WorkingDirectory=%h/work/driving-record
EnvironmentFile=-%h/work/driving-record/driving-log-runtime/environment
ExecStart=%h/work/driving-record/driving-log archive create
ExecStart=%h/work/driving-record/driving-log archive replicate
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077
