[Unit]
Description=Daniel supervised driving log
After=network.target tailscaled.service

[Service]
Type=simple
WorkingDirectory=%h/work/driving-record
EnvironmentFile=-%h/work/driving-record/driving-log-runtime/environment
ExecStart=%h/work/driving-record/driving-log serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/work/driving-record/driving-log-runtime
UMask=0077

[Install]
WantedBy=default.target
